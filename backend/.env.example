# Copy this file to .env and adjust for your environment.

# ---------- Core ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Kigali
UNIVERSITY_NAME=Your University

# Comma separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database ----------
# Leave DB_ENGINE blank to use SQLite (default, zero setup).
# Set to "postgres" and fill the rest to use PostgreSQL - do this before any
# real deployment. SQLite has one writer at a time, which a busy campus with
# several gates recording simultaneously will hit.
DB_ENGINE=
# DB_NAME, DB_USER and DB_PASSWORD apply to PostgreSQL only. Leave DB_NAME
# blank while DB_ENGINE is blank: on SQLite it is read as a file path, so a
# bare name such as "etracker" creates backend/etracker and you start from an
# empty register wondering where the data went.
DB_NAME=
DB_USER=etracker
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------- Auth ----------
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=7

# ---------- Rate limits ----------
# Per staff account, on the endpoints that can read the whole register.
# Burst catches a script; daily catches a slow scrape across a shift.
LOOKUP_BURST_RATE=120/min
LOOKUP_DAILY_RATE=4000/day

# The public student form, per IP. Leave this alone for anything a student can
# reach: 12/hour is plenty for filling in a form and fixing a typo, and far too
# little to grind registration numbers. Raise it only for an end-to-end test
# run against a throwaway server.
PUBLIC_FORM_RATE=12/hour

# ---------- Read audit log ----------
# How long lookups are kept. 365 days is a defensible starting point, not
# advice: this is a policy decision for the university. Pruned by
#   * 3 * * * cd /srv/etracker/backend && .venv/bin/python manage.py prune_audit_log
AUDIT_RETENTION_DAYS=365

# Alerting on unusual read volume. Each account is compared against its own
# recent baseline, so one number does not have to fit both a busy main gate and
# a quiet service gate. Empty recipients means alerting is inert.
#   0 * * * * cd /srv/etracker/backend && .venv/bin/python manage.py check_audit_alerts
AUDIT_ALERT_RECIPIENTS=
AUDIT_ALERT_WINDOW_HOURS=24
AUDIT_ALERT_BASELINE_DAYS=14
# Alert when an account reads this many times its own usual volume.
AUDIT_ALERT_MULTIPLIER=5
# ...but never below this many reads, so a new account cannot trip on a handful.
AUDIT_ALERT_FLOOR=200
AUDIT_ALERT_COOLDOWN_HOURS=24

# ---------- HTTPS (production) ----------
# These only take effect when DJANGO_DEBUG=False.
DJANGO_SSL_REDIRECT=True
# Set False only if Django terminates TLS itself rather than sitting behind
# nginx/Traefik/a load balancer. Getting this wrong causes a redirect loop.
DJANGO_BEHIND_PROXY=True
# Start at one day. Raise to 31536000 once every subdomain is HTTPS-only.
DJANGO_HSTS_SECONDS=86400
DJANGO_HSTS_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# ---------- Uploads ----------
MAX_UPLOAD_BYTES=8388608

# Photos are never served straight off disk. The API hands out signed links
# that expire, because `<img src>` cannot send an auth header and a filename
# is not a password. This is how long one link stays usable: long enough to
# read a page and open a photo full size, short enough that a URL copied out
# of the address bar is stale by the time it travels.
MEDIA_LINK_TTL_SECONDS=900

# With nginx in front, let it send the bytes once Django has checked the
# signature. Needs the matching `internal` location block from the README.
MEDIA_ACCEL_REDIRECT=False
MEDIA_ACCEL_PREFIX=/protected-media/

# ---------- Notifications ----------
# Email the owner when their computer leaves campus.
NOTIFY_ON_EXIT=True

# Email, chosen by EMAIL_PROVIDER:
#   console - prints to the terminal (development)
#   resend  - the Resend HTTP API
#   smtp    - any ordinary mail server, configured below
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Resend will not send from a domain you have not verified in its dashboard.
# Until you have one, onboarding@resend.dev works immediately and needs no DNS.
DEFAULT_FROM_EMAIL=etracker <onboarding@resend.dev>

# Only used when EMAIL_PROVIDER=smtp.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# SMS, chosen by SMS_PROVIDER:
#   console        - logs instead of sending, so nothing silently costs money
#   africastalking - the Africa's Talking REST API
#   null           - sends nothing at all
SMS_PROVIDER=console

# The sandbox is a SEPARATE app with its own API key: a live key will not
# authenticate against username=sandbox. Switch to the sandbox app in the
# dashboard and generate the key there, or set your live username here.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# An alphanumeric name such as ETRACKER, or a registered short code. Never a
# phone number. Ignored in the sandbox, and rejected on live until the
# university has registered it. Leave blank until then: a number here is
# detected and dropped, so the account default applies rather than every
# message failing.
AFRICASTALKING_SENDER_ID=

# How queued notifications actually get sent:
#   inline - during the request (development and tests only)
#   thread - a background thread after commit (single-process deployments)
#   worker - `manage.py process_notifications` drains the outbox (production)
# Notifications are always written to the outbox first, so nothing is lost
# whichever mode is chosen. Run the worker from cron every minute:
#   * * * * * cd /srv/etracker/backend && .venv/bin/python manage.py process_notifications
NOTIFY_DISPATCH=worker
