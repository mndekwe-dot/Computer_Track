# Copy to .env and point at your Django server.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Minutes of inactivity before a signed-in session ends itself.
# The gate console runs on a shared terminal that is often left facing a queue,
# so this matters more here than in a normal admin app. A warning appears 60
# seconds beforehand, and any real interaction cancels it.
VITE_IDLE_MINUTES=30
