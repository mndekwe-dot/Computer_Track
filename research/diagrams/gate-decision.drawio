        <mxCell id="details" value="Console shows the owner photograph,&#10;brand, colour and serial number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="375" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="dBearer" value="Does the bearer match&#10;the owner photograph?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="250" height="95" as="geometry" />
