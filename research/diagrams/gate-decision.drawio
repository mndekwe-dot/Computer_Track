        <mxCell id="dBlock" value="Any blocking reason?&#10;stolen · lost · pending&#10;active hold · owner suspended" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="605" width="270" height="110" as="geometry" />
