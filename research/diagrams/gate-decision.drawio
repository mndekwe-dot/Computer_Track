          <mxGeometry x="300" y="160" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="unreg" value="UNREGISTERED&#10;Guard records the attempt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="175" width="210" height="60" as="geometry" />
