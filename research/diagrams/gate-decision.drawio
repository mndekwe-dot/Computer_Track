          <mxGeometry x="290" y="755" width="270" height="105" as="geometry" />
        </mxCell>

        <mxCell id="clear" value="CLEAR&#10;Allow through" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
