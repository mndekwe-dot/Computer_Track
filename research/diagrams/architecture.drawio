          <mxGeometry x="1015" y="425" width="90" height="35" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Why the outbox: a notification row is written inside the same transaction as the event it describes, then a worker sends it. Sending inline would put a mail server round trip on the critical path of the action that must never be slow, and a mail server having a bad afternoon would lose the message. Why the queue: gates sit on the perimeter on wifi that drops. Decisions are stored locally and replayed with idempotency keys, and every rule is enforced again on arrival." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=11;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Scale: 7 Django apps · ~15,500 lines of Python · ~10,300 lines of JavaScript · 300 backend tests · 51 frontend tests · 56 end to end tests." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;fontSize=11;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="610" y="520" width="520" height="70" as="geometry" />
        </mxCell>

