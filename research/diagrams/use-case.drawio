        </mxCell>

        <!-- r6: Override a hold «extend» Record the gate decision -->
        <mxCell id="r6" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#15803D;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#15803D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="u9" target="u8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- r7: Queue a decision offline «extend» Record the gate decision -->
        <mxCell id="r7" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#15803D;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#15803D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="u10" target="u8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="897" />
              <mxPoint x="595" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- r8: Record the gate decision «include» Write to append-only scan log -->
        <mxCell id="r8" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#7E22CE;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#7E22CE;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="u8" target="u23">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="645" y="724" />
              <mxPoint x="645" y="587" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- r9: Send a notification «extend» Record the gate decision (FIXED UML 2.5 DIRECTION: extending use case u22 -> base use case u8) -->
        <mxCell id="r9" value="&amp;laquo;extend&amp;raquo;&#xa;(on permitted OUT)" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#7E22CE;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#7E22CE;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="u22" target="u8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="645" y="817" />
              <mxPoint x="645" y="737" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- r10: Approve or reject «include» Record approval evidence -->
        <mxCell id="r10" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#B45309;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#B45309;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u12" target="u13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- r11: Approve or reject «include» Send a notification -->
        <mxCell id="r11" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;endSize=10;dashed=1;dashPattern=6 4;html=1;rounded=0;strokeColor=#7E22CE;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=2;fontColor=#7E22CE;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="u12" target="u22">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="995" y="242" />
              <mxPoint x="995" y="817" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Notes Card -->
        <mxCell id="ucnote" value="&lt;b&gt;Behavioral Design Notes&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Role Inheritance:&lt;/b&gt; Administrator inherits Registration Officer and Security Guard capabilities.&lt;br/&gt;2. &lt;b&gt;Public Portal:&lt;/b&gt; Creates a &lt;i&gt;PENDING&lt;/i&gt; record only after identity verification (&amp;laquo;include&amp;raquo;).&lt;br/&gt;3. &lt;b&gt;Human-in-the-Loop:&lt;/b&gt; Override &amp;laquo;extend&amp;raquo;s the gate decision with a mandatory written reason." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Segoe UI;fontSize=10.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="30" y="820" width="205" height="180" as="geometry" />
        </mxCell>

        <!-- UML 2.5 Use Case Notation Legend -->
        <mxCell id="legend" value="&lt;b&gt;UML 2.5 Use Case Relationship Notation Legend&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;────────&lt;/b&gt; &lt;b&gt;Actor-to-Use-Case Communication Association:&lt;/b&gt; Solid line connecting a Primary Actor (left/right) or Secondary External System (bottom) to an interactive use case.&lt;br/&gt;&lt;b&gt;- - &amp;laquo;include&amp;raquo; - -▷&lt;/b&gt; &lt;b&gt;Mandatory Inclusion (Base ──▷ Included):&lt;/b&gt; Base use case &lt;i&gt;always&lt;/i&gt; executes the target sub-use case (e.g., &lt;i&gt;Register a device&lt;/i&gt; always includes &lt;i&gt;Verify identity&lt;/i&gt;).&lt;br/&gt;&lt;b&gt;- - &amp;laquo;extend&amp;raquo; - -▷&lt;/b&gt; &lt;b&gt;Conditional Extension (Extending ──▷ Base):&lt;/b&gt; Extending use case &lt;i&gt;conditionally&lt;/i&gt; augments the base use case when an extension point condition holds.&lt;br/&gt;&lt;b&gt;────────▷&lt;/b&gt; &lt;b&gt;Actor Generalization (Child ──▷ Parent):&lt;/b&gt; Hollow triangle arrowhead showing that &lt;i&gt;Administrator&lt;/i&gt; inherits all use cases of &lt;i&gt;Registration Officer&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=10.5;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="1020" width="415" height="175" as="geometry" />
        </mxCell>

        <mxCell id="legend2" value="&lt;b&gt;Subsystem Color Coding&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;■ Blue:&lt;/b&gt;&lt;/font&gt; Public Self-Service Portal (No Login Required)&lt;br/&gt;&lt;font color=&quot;#15803D&quot;&gt;&lt;b&gt;■ Green:&lt;/b&gt;&lt;/font&gt; Gate Verification Console (Security Guard)&lt;br/&gt;&lt;font color=&quot;#7E22CE&quot;&gt;&lt;b&gt;■ Purple:&lt;/b&gt;&lt;/font&gt; Automated System Actions &amp; External Gateways&lt;br/&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;■ Amber:&lt;/b&gt;&lt;/font&gt; Registration Office Operations (Registrar)&lt;br/&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;■ Red:&lt;/b&gt;&lt;/font&gt; System Configuration &amp; Audit Oversight (Admin)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=10.5;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="990" y="1020" width="380" height="175" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
