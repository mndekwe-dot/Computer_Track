              <mxPoint x="615" y="445" />
              <mxPoint x="615" y="816" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 9. Device ───▶ ScanEvent (Directed Association: 0..1 checked in 0..*) -->
        <mxCell id="rel_dev_scan" value="0..1   checked in   0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=10;fontStyle=1;startArrow=none;endArrow=open;endFill=0;endSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.32;entryX=0;entryY=0.43;" edge="1" parent="1" source="cls_device" target="cls_scan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. Student ───▶ ScanEvent (Directed Association: 0..1 bearer in 0..*) routed along top y=68 -->
        <mxCell id="rel_stu_scan" value="0..1   bearer in   0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=10;fontStyle=1;startArrow=none;endArrow=open;endFill=0;endSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.35;entryY=0;" edge="1" parent="1" source="cls_student" target="cls_scan">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="68" />
              <mxPoint x="1178" y="68" />
