              <mxPoint x="650" y="535" />
              <mxPoint x="650" y="842" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. Student ───▶ OwnershipTransfer (Directed Association: 1 from/to 0..*) -->
        <mxCell id="rel_stu_trans" value="1   from / to   0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1D4ED8;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontStyle=1;startArrow=none;endArrow=open;endFill=0;endSize=10;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0;entryY=0.25;" edge="1" parent="1" source="cls_student" target="cls_transfer">
          <mxGeometry relative="1" as="geometry">
