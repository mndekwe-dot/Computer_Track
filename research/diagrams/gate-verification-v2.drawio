<mxfile host="app.diagrams.net" type="device">
  <diagram name="Gate verification" id="gateflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="Gate verification decision flow" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="start" value="Student arrives at a gate carrying a device" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="40" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="ident" value="How is the device identified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="unreg" value="UNREGISTERED&#10;Guard records the attempt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="found" value="Device record retrieved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="260" height="40" as="geometry"/></mxCell>
        <mxCell id="show" value="Console shows owner photograph,&#10;brand, colour, serial and status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="bearer" value="Does the bearer match the owner photograph?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="415" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="block" value="Any blocking reason?&#10;stolen · lost · pending&#10;active hold · owner suspended" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="545" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="hold" value="HOLD&#10;Guard reads the configured reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="565" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="prop" value="Leaving with university property and no valid pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="705" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="clear" value="CLEAR&#10;Allow through" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="850" width="260" height="56" as="geometry"/></mxCell>
        <mxCell id="ovr" value="Guard overrides?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="705" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="override" value="OVERRIDE&#10;Written reason stored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="850" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="denied" value="DENIED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="945" width="210" height="44" as="geometry"/></mxCell>
        <mxCell id="net" value="Network available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="950" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="queue" value="Queued locally with an idempotency key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="recheck" value="On reconnection the server re-applies every rule and rejects replays" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="log" value="Scan written to the append-only log&#10;device · student · gate · guard&#10;direction · verdict · time" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1085" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="notify" value="Owner notified by SMS or email, if the rule is enabled" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1215" width="260" height="56" as="geometry"/></mxCell>
        <mxCell id="done" value="Student passes, or is held" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1300" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="g0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="start" target="ident"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g1" value="QR · serial · asset tag&#10;registration number" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="ident" target="found"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="ident" target="unreg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="found" target="show"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="show" target="bearer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="bearer" target="hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="462" /></Array></mxGeometry></mxCell>
        <mxCell id="g6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="bearer" target="block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g7" value="one or more" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="block" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g8" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="block" target="prop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="prop" target="hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="757" /><mxPoint x="650" y="605" /></Array></mxGeometry></mxCell>
        <mxCell id="g10" value="no, or a valid pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="prop" target="clear"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="hold" target="ovr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g12" value="yes, with a written reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="ovr" target="override"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="ovr" target="denied"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="750" /><mxPoint x="930" y="967" /></Array></mxGeometry></mxCell>
