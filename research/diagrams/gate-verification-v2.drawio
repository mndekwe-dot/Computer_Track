        <mxCell id="g15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="override" target="net"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="880" /><mxPoint x="640" y="1000" /></Array></mxGeometry></mxCell>
        <mxCell id="g16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="denied" target="net"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="658" y="967" /><mxPoint x="658" y="1018" /></Array></mxGeometry></mxCell>
        <mxCell id="g17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="unreg" target="net"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="165" /><mxPoint x="950" y="1062" /><mxPoint x="460" y="1062" /></Array></mxGeometry></mxCell>
        <mxCell id="g18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="net" target="log"><mxGeometry relative="1" as="geometry"/></mxCell>
