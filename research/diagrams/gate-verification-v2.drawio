        <mxCell id="g21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="recheck" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1132" /></Array></mxGeometry></mxCell>
        <mxCell id="g22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="log" target="notify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4D5A66;" edge="1" parent="1" source="notify" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gnote" value="Every path ends in a stored record, including the ones that found nothing. The software advises; the guard decides. Any hold can be overridden with a written reason, because a gate that cannot be overridden cannot let an ambulance through." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="230" height="160" as="geometry"/></mxCell>
