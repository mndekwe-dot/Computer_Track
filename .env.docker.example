# Copy to .env before `docker compose up`.
#
#   cp .env.docker.example .env
#
# Everything here is read by the api, worker and beat containers. The two
# marked required have no safe default and compose will refuse to start
# without them.

# ---------- required ----------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DB_PASSWORD=

# ---------- core ----------
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=Africa/Kigali
DB_NAME=etracker
DB_USER=etracker

# Where a browser reaches each half. These are what get compiled into the
# frontend bundle and used to build links in messages, so they are the public
# addresses, not the names containers use to talk to each other.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:8080
SITE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Behind a proxy that terminates TLS, leave this True. Set it False only if
# Django itself serves HTTPS - getting it wrong causes a redirect loop.
DJANGO_BEHIND_PROXY=True
# Off by default so the compose stack works over plain HTTP on a laptop.
# Turn it on for anything reachable from outside.
DJANGO_SSL_REDIRECT=False

# ---------- ports on the host ----------
WEB_PORT=8080
API_PORT=8000

# ---------- workers ----------
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=2

# ---------- email: Resend ----------
# console prints to the container log and sends nothing.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=etracker <no-reply@your-university.edu>

# ---------- SMS: Africa's Talking ----------
# console logs instead of sending, so nothing silently costs money.
SMS_PROVIDER=console
# SMS_PROVIDER=africastalking
# "sandbox" is the literal username for the test environment and selects the
# sandbox host automatically.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# The alphanumeric sender id you registered. Blank uses the shared pool.
AFRICASTALKING_SENDER_ID=
# Local numbers are stored as people write them ("0788..."); this is the
# country code they are rewritten into.
SMS_DEFAULT_COUNTRY_CODE=+250

# ---------- notifications ----------
# celery hands each batch to the worker. inline sends during the request and
# is for development only.
NOTIFY_DISPATCH=celery

# Where unusual-activity and suspicious-registration alerts go. Empty means
# nobody is told, including when a computer reported stolen is re-submitted.
AUDIT_ALERT_RECIPIENTS=
